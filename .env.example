# Neon Postgres — connection string direta (NUNCA no bundle do front)
# Usada apenas em migrations locais / CI
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Data API — URL pública (exposta ao front via VITE_)
VITE_NEON_API_URL=https://your-project.neon.tech/api/v1

# Neon Auth
VITE_NEON_AUTH_URL=https://your-project.neon.tech/auth

# Série BCB (IPCA = 433)
BCB_SERIE=433

# GitHub Actions secrets (usados apenas nos workflows)
# NEON_CONNECTION_STRING=
# IPCA_ROLE_CONNECTION_STRING=  (role restrita à tabela taxas_ipca)

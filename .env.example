# Copie para .env.local e preencha com seus valores
# NUNCA commite .env.local

# Connection string Neon (só em migrations/scripts — nunca no front)
DATABASE_URL=postgresql://user:password@ep-xxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth URL (habilitar no Console > Settings > Neon Auth)
# Formato: https://ep-xxx.neonauth.c-2.<region>.aws.neon.build/<db>/auth
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.sa-east-1.aws.neon.build/neondb/auth

# Neon Data API — PostgREST (habilitar no Console > Settings > Data API)
# Formato: https://ep-xxx.apirest.c-2.<region>.aws.neon.build/<db>/rest/v1
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.sa-east-1.aws.neon.build/neondb/rest/v1
